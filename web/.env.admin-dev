# Used by 'pnpm start:admin' to develop the administration UI, see dev/admin/README.md.
VITE_DEV_BACKEND=http://127.0.0.1:9095
# The portal domain from dev/admin/configuration.example.yml, so the sign-in pages can be opened on the dev server.
VITE_DEV_FORWARDED_HOST=idm.example.com
VITE_BASEPATH=
VITE_THEME=auto
VITE_DUO_SELF_ENROLLMENT=false
VITE_LOGO_OVERRIDE=false
VITE_PRIVACY_POLICY_ACCEPT=false
VITE_PRIVACY_POLICY_URL=
VITE_PASSKEY_LOGIN=false
VITE_REMEMBER_ME=true
VITE_RESET_PASSWORD=true
VITE_RESET_PASSWORD_CUSTOM_URL=
